    "vite": "7.3.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.12",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.3"
