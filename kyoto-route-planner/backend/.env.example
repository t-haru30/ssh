# Copy this file to backend/.env and fill in your own keys. Never commit .env.

# Yahoo! JAPAN Local Search (required for spot search): Client ID / Application ID
YAHOO_APP_ID=

# Ekispert API (required for route calculation)
EKISPERT_API_KEY=
EKISPERT_APPLICATION_URL=http://127.0.0.1:8000

# Gemini (optional: falls back to template copy when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Venue summaries with Google Search grounding (optional; disabled by default).
# For Cloud Run, supply a team-owned key through Secret Manager.
# This feature never falls back to GEMINI_API_KEY.
VENUE_EVIDENCE_ENABLED=0
RECOMMENDATION_GEMINI_API_KEY=
RECOMMENDATION_GEMINI_MODEL=gemini-3.8-flash
