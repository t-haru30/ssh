# Copy this file to backend/.env and fill in your own keys. Never commit .env.

# Yahoo! JAPAN Local Search (legacy local mode only): Client ID / Application ID
YAHOO_APP_ID=

# The Docker image uses the bundled, redistributable OSM catalog by default.
# Local legacy API searches use Yahoo unless this is set to public_catalog.
PLACE_SEARCH_PROVIDER=
# Up to five nearby/regional-food Places searches when meals are requested.
# Uses GOOGLE_PLACES_API_KEY and the shared GOOGLE_PLACES_MONTHLY_LIMIT.
# OSM remains the independently sourced, savable facility data.
GOOGLE_RESTAURANTS_ENABLED=1

# Ekispert API (required for route calculation)
EKISPERT_API_KEY=
EKISPERT_APPLICATION_URL=http://127.0.0.1:8000

# Shared server-side Gemini key (copywriting, venue summaries and photo metadata matching).
# Local private settings: .local/personal-api.env at the project root.
# Production: provide through Secret Manager / environment variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Review summaries and missing official visitor guides via Google Search (optional).
# Official search runs only when an opened destination detail lacks verified fields.
# For Cloud Run, supply a team-owned key through Secret Manager.
VENUE_EVIDENCE_ENABLED=0
# Legacy RECOMMENDATION_GEMINI_API_KEY is still accepted when GEMINI_API_KEY is absent.
# Optional override for venue summaries; otherwise GEMINI_MODEL is used.
# RECOMMENDATION_GEMINI_MODEL=gemini-3.8-flash

# Retained illustration service (opt-in; not called by Discover cards).
ROUTE_ILLUSTRATIONS_ENABLED=0
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
ROUTE_ILLUSTRATION_DAILY_LIMIT=10
# Optional persistent cache directory; never expose credentials in the frontend.
ROUTE_ILLUSTRATION_CACHE_DIR=

# Optional: enable Places API (New). Never reuse or expose the Gemini key.
GOOGLE_PLACES_API_KEY=
# Local persistent monthly lookup cap (each lookup uses at most two Google calls).
GOOGLE_PLACES_MONTHLY_LIMIT=300

# Separate public browser key: enable Maps JavaScript API and Routes API, restrict by HTTP
# referrer (http://127.0.0.1:8011/* and the deployed site). Never copy the Places key.
GOOGLE_MAPS_BROWSER_API_KEY=
# Optional production map ID. Routes API must also be enabled for route geometry.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
GOOGLE_MAPS_ROUTE_PROVIDER=google

# Catalog administration: enable only on an IAM-private admin service.
CATALOG_ADMIN_ENABLED=0
CATALOG_AGENT_ENABLED=0
CATALOG_STORE=sqlite
# GOOGLE_CLOUD_PROJECT=your-project
# CATALOG_FIRESTORE_DATABASE=conciergo-catalog
CATALOG_DAILY_LIMIT=100
